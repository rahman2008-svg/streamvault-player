<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Vault / Media Shield Shape -->
    <path
        android:pathData="M 54,18 L 84,30 L 84,62 C 84,81 54,94 54,94 C 54,94 24,81 24,62 L 24,30 Z"
        android:strokeWidth="4"
        android:strokeColor="#38BDF8"
        android:fillColor="#1E293B">
    </path>
    
    <!-- Outer Shield Secondary Outline -->
    <path
        android:pathData="M 54,23 L 79,33 L 79,60 C 79,76 54,88 54,88 C 54,88 29,76 29,60 L 29,33 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#2DD4BF"
        android:fillColor="#00000000" />

    <!-- Center Play Icon with Gradient fill -->
    <path
        android:pathData="M 44,38 L 44,70 L 71,54 Z"
        android:fillType="nonZero">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="38"
                android:endX="71"
                android:endY="70"
                android:type="linear">
                <item
                    android:offset="0.0"
                    android:color="#FFFFFF" />
                <item
                    android:offset="1.0"
                    android:color="#38BDF8" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Decorative modern tech lines -->
    <path
        android:pathData="M 38,44 L 38,64"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeColor="#2DD4BF" />
        
    <path
        android:pathData="M 44,54 L 41,54"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeColor="#E2E8F0" />
</vector>
